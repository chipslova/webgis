{
  "version": 8,
  "name": "OpenStreetMap Standard",
  "sources": {
    "osm-source": {
      "type": "raster",
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "osm-standard-layer",
      "type": "raster",
      "source": "osm-source",
      "minzoom": 0
    }
  ]
}