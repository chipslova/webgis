{
  "version": 8,
  "name": "Esri Open Topo",
  "sources": {
    "opentopo-source": {
      "type": "raster",
      "tiles": [
        "https://tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 17,
      "attribution": "Map data: © OpenStreetMap contributors, SRTM | Map style: © OpenTopoMap (CC-BY-SA)"
    }
  },
  "layers": [
    {
      "id": "opentopo-layer",
      "type": "raster",
      "source": "opentopo-source",
      "minzoom": 0,
      "maxzoom": 17
    }
  ]
}