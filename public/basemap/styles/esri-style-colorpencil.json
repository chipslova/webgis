{
  "version": 8,
  "name": "Esri Street Map",
  "sources": {
    "esri-street-source": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "Sources: Esri, DeLorme, NAVTEQ, TomTom, USGS, Intermap, iPC, METI, NRCAN, Esri Japan, METI, Esri China (Hong Kong)"
    }
  },
  "layers": [
    {
      "id": "esri-street-layer",
      "type": "raster",
      "source": "esri-street-source",
      "minzoom": 0,
      "maxzoom": 19
    }
  ]
}